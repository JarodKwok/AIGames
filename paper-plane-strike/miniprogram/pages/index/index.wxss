.page {
  width: 100%;
  min-height: 100vh;
  padding: 24rpx;
  margin: 0 auto;
  max-width: 960rpx;
}

.header {
  display: flex;
  align-items: center;
  padding: 28rpx 0 34rpx;
}

.header-side {
  flex: 1;
  min-width: 120rpx;
}

.header-side.right {
  display: flex;
  justify-content: flex-end;
}

.brand {
  flex: 2;
  text-align: center;
}

.title {
  color: #0c4a6e;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.1;
}

.title-bar {
  width: 96rpx;
  height: 10rpx;
  margin: 14rpx auto 0;
  border-radius: 999rpx;
  background: #38bdf8;
}

.lang-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  height: 54rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #0284c7;
  font-size: 24rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 24rpx rgba(14, 116, 144, 0.08);
}

.welcome {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
}

.welcome-card,
.panel,
.board-panel,
.log-panel,
.result-card {
  background: #ffffff;
  border: 2rpx solid #e0f2fe;
  box-shadow: 0 18rpx 48rpx rgba(14, 116, 144, 0.10);
}

.welcome-card {
  width: 100%;
  max-width: 640rpx;
  padding: 64rpx 46rpx;
  border-radius: 40rpx;
  text-align: center;
}

.plane-icon {
  margin-bottom: 20rpx;
  color: #0284c7;
  font-size: 88rpx;
  line-height: 1;
}

.welcome-title {
  color: #1e293b;
  font-size: 40rpx;
  font-weight: 900;
}

.welcome-desc {
  margin: 18rpx 0 46rpx;
  color: #64748b;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.7;
}

.panel {
  padding: 28rpx;
  border-radius: 32rpx;
}

.panel-head,
.board-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.panel-title {
  color: #334155;
  font-size: 30rpx;
  font-weight: 900;
}

.count-pill {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #e0f2fe;
  color: #0369a1;
  font-size: 22rpx;
  font-weight: 900;
}

.difficulty-block {
  margin: 0 0 24rpx;
}

.difficulty-title {
  margin-bottom: 12rpx;
  color: #64748b;
  font-size: 22rpx;
  font-weight: 900;
}

.difficulty-row {
  display: flex;
  gap: 8rpx;
  padding: 6rpx;
  border-radius: 20rpx;
  background: #f1f5f9;
  overflow: hidden;
}

.difficulty-button {
  display: flex;
  flex: 1 1 0;
  align-items: center;
  justify-content: center;
  width: 0;
  min-width: 0;
  height: 58rpx;
  padding: 0;
  border-radius: 16rpx;
  color: #64748b;
  font-size: 24rpx;
  font-weight: 900;
  white-space: nowrap;
}

.difficulty-button.active {
  background: #0f766e;
  color: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(15, 118, 110, 0.22);
}

.board {
  display: grid;
  grid-template-columns: repeat(10, 1fr);
  gap: 4rpx;
  width: 100%;
  padding: 4rpx;
  border: 4rpx solid #bae6fd;
  border-radius: 20rpx;
  background: #bae6fd;
  overflow: hidden;
}

.cell {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  border-radius: 4rpx;
  transition: transform 0.12s ease, filter 0.12s ease;
}

.cell.tapable:active {
  transform: scale(0.92);
  filter: brightness(0.96);
}

.cell-empty {
  background: #ffffff;
}

.cell-miss {
  background: #e2e8f0;
}

.cell-hit {
  background: #fb923c;
}

.cell-kill {
  background: #e11d48;
}

.plane-head {
  background: #38bdf8;
}

.plane-body {
  background: #e0f2fe;
}

.plane-head-selected {
  background: #0284c7;
}

.plane-body-selected {
  background: #7dd3fc;
}

.plane-head-confirmed {
  background: #7dd3fc;
}

.plane-body-confirmed {
  background: #f0f9ff;
}

.plane-destroyed {
  background: #94a3b8;
}

.miss-dot,
.hit-mark,
.kill-mark,
.head-ring,
.body-ring {
  position: absolute;
}

.miss-dot {
  left: 50%;
  top: 50%;
  width: 12rpx;
  height: 12rpx;
  margin-left: -6rpx;
  margin-top: -6rpx;
  border-radius: 999rpx;
  background: #94a3b8;
}

.hit-mark {
  left: 50%;
  top: 50%;
  width: 22rpx;
  height: 22rpx;
  margin-left: -11rpx;
  margin-top: -11rpx;
  border-radius: 4rpx;
  background: rgba(255, 247, 237, 0.72);
  transform: rotate(45deg);
}

.kill-mark {
  left: 0;
  right: 0;
  top: 50%;
  margin-top: -16rpx;
  color: #ffffff;
  text-align: center;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 32rpx;
}

.head-ring {
  left: 4rpx;
  right: 4rpx;
  top: 4rpx;
  bottom: 4rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.55);
  border-radius: 6rpx;
}

.head-ring.selected {
  border-color: #075985;
}

.body-ring {
  left: 5rpx;
  right: 5rpx;
  top: 5rpx;
  bottom: 5rpx;
  border: 2rpx solid rgba(2, 132, 199, 0.25);
  border-radius: 4rpx;
}

.direction-row {
  display: flex;
  gap: 12rpx;
  justify-content: center;
  margin: 24rpx 0;
}

.dir-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  height: 64rpx;
  padding: 0 20rpx;
  border: 4rpx solid #e2e8f0;
  border-radius: 18rpx;
  background: #ffffff;
  color: #64748b;
  font-size: 24rpx;
  font-weight: 900;
}

.dir-button.active {
  border-color: #0369a1;
  background: #0284c7;
  color: #ffffff;
}

.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 82rpx;
  border-radius: 20rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.10);
}

.btn:active {
  transform: scale(0.98);
}

.btn.primary {
  background: #0284c7;
}

.btn.secondary {
  background: #f8fafc;
  color: #475569;
  border: 4rpx solid #e2e8f0;
  box-shadow: none;
}

.btn.success {
  background: #10b981;
}

.btn.danger {
  background: #fff1f2;
  color: #e11d48;
  border: 4rpx solid #ffe4e6;
  box-shadow: none;
}

.btn.warning {
  background: #d97706;
}

.btn.wide {
  width: 100%;
}

.btn.compact {
  width: 220rpx;
  height: 64rpx;
  font-size: 22rpx;
}

.btn.disabled {
  background: #cbd5e1;
  color: #64748b;
  box-shadow: none;
}

.tip {
  margin-top: 22rpx;
  color: #94a3b8;
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.5;
}

.clear-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 60rpx;
  margin-top: 12rpx;
  color: #94a3b8;
  font-size: 22rpx;
  font-weight: 900;
}

.playing {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  padding-bottom: 40rpx;
}

.battle-meta {
  display: flex;
  justify-content: center;
  margin: -6rpx 0 -8rpx;
}

.battle-difficulty {
  padding: 12rpx 24rpx;
  border: 2rpx solid #99f6e4;
  border-radius: 999rpx;
  background: #ccfbf1;
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 20rpx rgba(15, 118, 110, 0.12);
}

.board-panel {
  padding: 22rpx;
  border-radius: 28rpx;
}

.section-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
  font-weight: 900;
}

.enemy-label {
  color: #e11d48;
}

.own-label {
  color: #0284c7;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: #e11d48;
}

.pulse {
  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {
  0% {
    transform: scale(0.85);
    opacity: 0.45;
  }
  50% {
    transform: scale(1.25);
    opacity: 1;
  }
  100% {
    transform: scale(0.85);
    opacity: 0.45;
  }
}

.plane-dots {
  display: flex;
  gap: 8rpx;
}

.plane-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 999rpx;
  border: 2rpx solid #bae6fd;
  background: #e0f2fe;
}

.plane-dot.enemy {
  border-color: #fecdd3;
  background: #ffe4e6;
}

.plane-dot.destroyed.enemy {
  border-color: #e11d48;
  background: #e11d48;
}

.plane-dot.destroyed.own {
  border-color: #0284c7;
  background: #0284c7;
}

.turn-hint {
  margin-top: 18rpx;
  padding: 18rpx 0;
  border-radius: 16rpx;
  color: #94a3b8;
  text-align: center;
  font-size: 24rpx;
  font-weight: 900;
}

.turn-hint.active {
  color: #0284c7;
}

.end-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 20rpx;
  border: 2rpx solid #fde68a;
  border-radius: 20rpx;
  background: #fef3c7;
}

.end-title {
  color: #92400e;
  font-size: 24rpx;
  font-weight: 900;
}

.log-panel {
  min-height: 176rpx;
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 10rpx 28rpx rgba(14, 116, 144, 0.06);
}

.log-title {
  margin-bottom: 10rpx;
  color: #94a3b8;
  font-size: 20rpx;
  font-weight: 900;
}

.log-line {
  padding: 6rpx 0;
  border-bottom: 2rpx solid #f8fafc;
  color: #94a3b8;
  font-size: 22rpx;
  line-height: 1.4;
}

.log-line.latest {
  color: #1e293b;
  font-weight: 900;
}

.result-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 44rpx;
  background: rgba(15, 23, 42, 0.9);
}

.result-card {
  width: 100%;
  max-width: 620rpx;
  padding: 58rpx 42rpx;
  border-radius: 40rpx;
  text-align: center;
}

.result-icon {
  margin-bottom: 24rpx;
  font-size: 90rpx;
  line-height: 1;
}

.result-title {
  color: #1e293b;
  font-size: 56rpx;
  font-weight: 900;
}

.result-desc {
  margin: 18rpx 0 28rpx;
  color: #64748b;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.7;
}

.stats-panel {
  margin: 0 0 34rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f8fafc;
}

.stats-title {
  margin-bottom: 16rpx;
  color: #64748b;
  font-size: 22rpx;
  font-weight: 900;
}

.stats-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.stats-item {
  padding: 16rpx 8rpx;
  border-radius: 18rpx;
  background: #ffffff;
}

.stats-number {
  color: #1e293b;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.1;
}

.stats-label {
  margin-top: 8rpx;
  color: #94a3b8;
  font-size: 20rpx;
  font-weight: 900;
}

.stats-item.player .stats-number {
  color: #0284c7;
}

.stats-item.enemy .stats-number {
  color: #e11d48;
}
